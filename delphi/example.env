# Server configuration
HOST=localhost
PORT=8080
# Default WARN
LOG_LEVEL=INFO
MATH_ENV=dev

# LLM configuration
# Default is ollama (alternative: anthropic)
LLM_PROVIDER=ollama
# Default is llama3.1:8b - other options: llama3, gemma:7b, mistral, mixtral, etc.
OLLAMA_MODEL=llama3.1:8b
# For local development, use localhost
OLLAMA_HOST=http://ollama:11434

# Optional Sentence Transformer configuration. Used only when
# DELPHI_THEME_EMBEDDING_MODE is embedding or auto selects the embedding path.
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# Alternative multilingual model (uncomment to use)
# SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Standard Docker preserves the historical embedding path. Set this to tfidf
# for a memory-safe worker, or auto to use TF-IDF below the configured threshold.
DELPHI_THEME_EMBEDDING_MODE=embedding
DELPHI_THEME_EMBEDDING_MAX_STATEMENTS=128
DELPHI_THEME_TFIDF_MAX_FEATURES=2048
DELPHI_THEME_TFIDF_COMPONENTS=32
DELPHI_THEME_EMBEDDING_BATCH_SIZE=16
DELPHI_NUM_THREADS=1

# Database configuration
DATABASE_HOST=localhost
DATABASE_NAME=polis-dev
DATABASE_PASSWORD=oiPorg3Nrz0yqDLE
DATABASE_PORT=5432
DATABASE_USER=postgres

# Database advanced
DATABASE_SSL_MODE=disable
# Default 5
DATABASE_POOL_SIZE=5
# Default 10

# DynamoDB
DYNAMODB_ENDPOINT=http://host.docker.internal:8000
# Legacy jobs remain enabled by default. Set false to run only the PostgreSQL
# automatic-theme worker in a standard Docker deployment.
DELPHI_DYNAMODB_ENABLED=

# PostgreSQL automatic themes are enabled by default. These are optional tuning
# values and are shared with the API server.
DELPHI_AUTO_REFRESH_ENABLED=true
DELPHI_AUTO_REFRESH_DEBOUNCE_MS=300000
DELPHI_AUTO_REFRESH_MAX_DELAY_MS=3600000
DELPHI_AUTO_REFRESH_MIN_INTERVAL_MS=1800000
DELPHI_AUTO_REFRESH_MIN_STATEMENTS=5

# Conversation configuration
# Default 5
CONV_GROUP_K_MAX=5
# Default 2
CONV_GROUP_K_MIN=2
# Default 400
CONV_MAX_CMTS=400
# Default 5000
CONV_MAX_PTPTS=5000

# Polling configuration
POLL_ALLOWLIST=
POLL_BLOCKLIST=
# Default 1000
POLL_INTERVAL_MS=1000
# Default 5000
POLL_MOD_INTERVAL_MS=5000
# Default 10000
POLL_TASK_INTERVAL_MS=10000
# Default 1000
POLL_VOTE_INTERVAL_MS=1000

# MinIO configuration for local S3-compatible storage
AWS_S3_ENDPOINT=http://host.docker.internal:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=polis-delphi
AWS_REGION=us-east-1

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
